# Postgres: local con Docker en desarrollo, Neon en producción (usar la URL "pooled")
# docker run -d --name travelar-postgres -e POSTGRES_USER=travelar -e POSTGRES_PASSWORD=travelar -e POSTGRES_DB=travelar -p 5433:5432 postgres:16
DATABASE_URL=postgres://travelar:travelar@localhost:5433/travelar

# Secreto para firmar la sesión del backoffice (mínimo 32 caracteres)
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32+

# Usuario administrador inicial (lo crea `npm run db:seed`)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar-esta-clave

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Cloudinary para imágenes subidas (públicas) y comprobantes (autenticados). Vacío = se guardan en data/
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME (Dashboard > API Keys)
CLOUDINARY_URL=

# Reseñas reales: API key de Google Cloud con "Places API (New)" habilitada
GOOGLE_PLACES_API_KEY=
# Protege /api/cron/* (Vercel Cron lo envía como Bearer)
CRON_SECRET=

# Mercado Pago (Checkout Pro). Sin MP_ACCESS_TOKEN solo se ofrece transferencia.
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones > Webhooks) para validar x-signature
MP_WEBHOOK_SECRET=

# Emails transaccionales (Resend). Sin clave, los emails quedan registrados como "no enviado".
RESEND_API_KEY=
# Remitente con dominio verificado en Resend
EMAIL_FROM="Agencia de Turismo <reservas@tudominio.com>"
